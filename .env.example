# Sahaja Solar Production Server Environment Variables Example
# IMPORTANT: Never commit actual secret keys or passwords to version control.

# ============================================================================
# API CONFIGURATION (FOR FRONTEND TO CONNECT TO BACKEND)
# ============================================================================
# Backend API Base URL (leave empty for same-origin, or set to Render backend URL)
# Development: leave empty (uses same server)
# Production: https://your-backend.onrender.com
VITE_API_BASE_URL=

# ============================================================================
# SUPABASE DATABASE (REQUIRED FOR PRODUCTION DATABASE PERSISTENCE)
# ============================================================================
# Supabase Project URL
SUPABASE_URL=your_supabase_project_url_here

# Supabase Service Role Key (SERVER-SIDE ONLY - DO NOT EXPOSE TO BROWSER)
# Found in: Supabase Dashboard > Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Supabase Anon Key (SAFE FOR CLIENT-SIDE - Used for Supabase Auth in browser)
# Found in: Supabase Dashboard > Settings > API > anon/public key
SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ============================================================================
# TRANSACTIONAL EMAIL NOTIFICATIONS (RESEND API - SERVER SIDE ONLY)
# ============================================================================
# Resend API Key (Found in: https://resend.com/api-keys)
# IMPORTANT: This is SERVER-SIDE ONLY - never expose to browser
RESEND_API_KEY=your_resend_api_key_here

# Verified Sender Email Address (Requires verified domain in Resend)
EMAIL_FROM="Sahaja Solar <notifications@sahajasolar.com>"

# Business Notification Email Recipient (Target for quote & booking alerts)
# Supports multiple emails separated by commas
BUSINESS_NOTIFICATION_EMAIL=sahajasolar@gmail.com,yashwanthk0705@gmail.com

# ============================================================================
# ASK SAHAJA AI ASSISTANT (OPENAI API - SERVER SIDE ONLY)
# ============================================================================
# OpenAI API Key (Found in: https://platform.openai.com/api-keys)
# IMPORTANT: This is SERVER-SIDE ONLY - never expose to browser
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI Model Selection (Cost-efficient default: gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini
